{
  "private": true,
  "author": "European Commission",
  "license": "EUPL-1.2",
  "description": "Europa Component Library",
  "scripts": {
    "changelog": "lerna-changelog",
    "clean": "rimraf dist",
    "browserstats": "./src/tools/builder/bin/build.js browsers",
    "build:icons": "pnpm --filter \"@ecl/resources-*\" run dist",
    "build:presets": "pnpm --filter \"@ecl/preset-*\" run dist",
    "build:themes": "pnpm --filter \"@ecl/theme-*\" run build",
    "dist:presets": "npm run build:presets && ./scripts/dist-presets.sh",
    "dist:storybook": "./scripts/dist-storybook.sh",
    "dist:website": "./scripts/dist-website.sh",
    "dist": "npm run clean && npm run browserstats && npm run dist:presets && npm run dist:storybook && npm run dist:website",
    "lint:js": "eslint . --ext .js --ext .jsx",
    "lint:scss": "stylelint \"./src/**/*.scss\"",
    "lint": "run-p lint:* -cln",
    "prepare": "husky",
    "postinstall": "scripts/check-inter.sh && [ -z \"$NOYARNPOSTINSTALL\" ] && (pnpm recursive run postinstall && pnpm recursive run prepublish) || echo \"Bypass prepublish\"",
    "pretty-check": "prettier --check \"src/**/*.{md,mdx,html,json,yml,js,jsx,scss,svg}\"",
    "pretty-write": "prettier --write \"src/**/*.{md,mdx,html,json,yml,js,jsx,scss,svg}\"",
    "publish": "scripts/publish.sh",
    "serve": "cd src/website && npm run serve",
    "size": "npm run dist:presets && size-limit",
    "start:ec": "(cd src/presets/ec && npm run watch) & cd src/playground/ec && npm run start",
    "start:eu": "(cd src/presets/eu && npm run watch) & cd src/playground/eu && npm run start",
    "start:website": "cd src/website && npm run start",
    "test": "run-p test:*",
    "test:components": "jest --verbose",
    "test:coding-conventions": "npm run lint && npm run pretty-check",
    "update-deps": "npm-check-updates -i -ws",
    "update-version": "scripts/update-version.sh"
  },
  "devDependencies": {
    "@babel/eslint-parser": "7.28.5",
    "@babel/plugin-proposal-export-default-from": "7.27.1",
    "@babel/plugin-syntax-dynamic-import": "7.8.3",
    "@babel/plugin-transform-runtime": "7.28.5",
    "@eslint/js": "9.39.1",
    "@prettier/plugin-xml": "3.4.2",
    "@size-limit/preset-big-lib": "11.2.0",
    "babel-jest": "30.2.0",
    "classnames": "2.5.1",
    "cross-env": "10.1.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.0.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-n": "17.23.1",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "6.1.0",
    "glob": "11.0.3",
    "global": "4.4.0",
    "husky": "9.1.7",
    "jest": "30.2.0",
    "jest-axe": "10.0.0",
    "jest-environment-jsdom": "30.2.0",
    "lerna": "9.0.0",
    "lerna-changelog": "2.2.0",
    "lint-staged": "16.2.6",
    "npm-check-updates": "19.1.2",
    "npm-run-all": "4.1.5",
    "postinstall-postinstall": "2.1.0",
    "prettier": "3.6.2",
    "prop-types": "15.8.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router": "7.9.5",
    "rimraf": "6.1.0",
    "size-limit": "11.2.0",
    "ssri": "12.0.0",
    "stylelint": "16.25.0",
    "stylelint-config-css-modules": "4.5.1",
    "stylelint-config-standard": "39.0.1",
    "stylelint-config-standard-scss": "16.0.0",
    "stylelint-order": "7.0.0",
    "stylelint-scss": "6.12.1",
    "unist-util-visit": "5.0.0"
  },
  "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd",
  "pnpm": {
    "overrides": {
      "serialize-javascript": ">=3.1.0",
      "trim": ">=0.0.3",
      "glob-parent": ">=5.1.2",
      "strip-ansi": "6.0.1",
      "ansi-html": ">=0.0.8",
      "follow-redirects": ">=1.14.7",
      "node-fetch": "2.6.7",
      "immer": ">=9.0.21",
      "merge": ">=2.1.1",
      "browserslist": ">=4.24.2",
      "node-forge": ">=1.0.0",
      "nth-check": ">=2.0.1",
      "prismjs": ">=1.27.0",
      "minimist": ">=1.2.6",
      "simple-git": ">=3.3.0",
      "portscanner": ">=2.2.0",
      "parse-path": ">=5.0.0",
      "parse-url": ">=8.1.0",
      "qs": ">=6.2.4",
      "json5": ">=2.2.2",
      "ua-parser-js": ">=1.0.33",
      "http-cache-semantics": ">=4.1.1",
      "webpack": ">=5.76.3",
      "yaml": ">=2.2.2",
      "puppeteer": "10.4.0",
      "loader-utils": "2.0.4",
      "lodash": ">=4.17.21",
      "semver": ">=7.5.2",
      "word-wrap": "aashutoshrathi/word-wrap",
      "postcss": ">=8.4.31",
      "@babel/traverse": ">=7.23.2",
      "axios": ">=1.7.4",
      "ip": ">=2.0.1",
      "ws": ">=8.17.1",
      "micromatch": ">=4.0.8",
      "serve-static": ">=1.16.0",
      "path-to-regexp": "0.1.12",
      "inquirer": "12.2.0",
      "nanoid": "3.3.8",
      "esbuild": "0.24.2"
    }
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.9.0"
  },
  "lint-staged": {
    "*.{md,mdx,html,json,yml,svg}": [
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "prettier --write",
      "eslint"
    ],
    "*.scss": [
      "prettier --write",
      "stylelint"
    ]
  },
  "jest": {
    "verbose": true,
    "testEnvironment": "jsdom"
  },
  "apps": {
    "storybook-ec": {
      "protocol": "http",
      "port": 6006,
      "host": "localhost"
    },
    "storybook-eu": {
      "protocol": "http",
      "port": 6007,
      "host": "localhost"
    }
  }
}
