{
  "compilerOptions": {
    // Allows relative "paths" to be based on the project root.
    "baseUrl": ".",
    "paths": {
      // Example wildcard alias for anything in `src/`
      "@/*": ["./src/*"],

      // Aliases for `@ecl/website-components`
      "@ecl/website-components": ["./src/website-components/*"],

      // Aliases for `@ecl/website-utils`
      "@ecl/website-utils": ["./src/utils/*"]
    }
  }
}
