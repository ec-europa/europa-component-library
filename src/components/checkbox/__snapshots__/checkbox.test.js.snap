      <span
        class="ecl-checkbox__box"
      >
        <span
          aria-hidden="true"
          class="wt-icon--check ecl-icon ecl-icon--xs ecl-checkbox__icon ecl-icon--check"
        />
      </span>
      <span
        class="ecl-checkbox__text"
      >
        Belgium
      </span>
    </label>
  </div>
  <div
    class="ecl-checkbox ecl-checkbox--disabled"
  >
    <input
      class="ecl-checkbox__input"
      disabled=""
      id="checkbox-default-3"
      name="checkbox-default"
      type="checkbox"
      value="fr"
    />
    <label
      class="ecl-checkbox__label"
      for="checkbox-default-3"
    >
      <span
        class="ecl-checkbox__box ecl-checkbox__box--disabled"
      >
        <span
          aria-hidden="true"
