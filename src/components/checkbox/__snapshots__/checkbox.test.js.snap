exports[`Checkbox Default renders correctly 1`] = `
<jest>
  <div
    class="ecl-checkbox"
  >
    <input
      checked=""
      class="ecl-checkbox__input"
      id="checkbox-default-1"
      name="checkbox-default"
      type="checkbox"
      value="es"
    />
    <label
      class="ecl-checkbox__label"
      for="checkbox-default-1"
    >
      <span
        class="ecl-checkbox__box"
      >
        <span
          aria-hidden="true"
          class="wt-icon--check ecl-icon ecl-icon--xs ecl-checkbox__icon ecl-icon--check"
        />
      </span>
      <span
        class="ecl-checkbox__text"
      >
        Spain
      </span>
    </label>
  </div>
  <div
    class="ecl-checkbox"
  >
    <input
      class="ecl-checkbox__input"
      id="checkbox-default-2"
      name="checkbox-default"
      type="checkbox"
      value="be"
    />
