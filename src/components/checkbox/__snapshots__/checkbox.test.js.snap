        />
      </span>
      <span
        class="ecl-checkbox__text"
      >
        France (disabled)
      </span>
    </label>
  </div>
  <div
    class="ecl-checkbox"
  >
    <input
      class="ecl-checkbox__input"
      id="checkbox-default-4"
      name="checkbox-default"
      type="checkbox"
      value="lorem"
    />
    <label
      class="ecl-checkbox__label"
      for="checkbox-default-4"
