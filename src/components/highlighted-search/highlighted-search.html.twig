{% apply spaceless %}

{#
  Parameters:
    - "id" (string) (default: random) Unique id for the component
    - "color_mode" (string) The color mode name
    - "title" (string) (default: '') Title of highlighted search
    - "description" (string) (default: '') Description of highlighted search
    - "search_input" (object) (default: {}) Search field, following ECL Text Input structure.
    - "search_label" (string) (default: '') Search label; for screen readers; falls back to the placeholder if not provided
    - "search_helper" (string) (default: '') Search helper, for additional information
    - "search_button" (object) (default: {}) Search button, following ECL Button structure
    - "suggestion_label" (string) (default: '') Label for the suggestions
    - "suggestion" (object) (default: {}) List of tags, following the ECL Tag Set structure
    - "extra_classes" (string) (default: '')
    - "extra_attributes" (optional) (array) (default: [])
      - "name" (string) Attribute name, eg. 'data-test'
      - "value" (optional) (string) Attribute value, eg: 'data-test-1'
#}

{# Internal properties #}

{% set _css_class = 'ecl-highlighted-search' %}
{% set _extra_attributes = '' %}

{% set _id = id|default('ecl-highlighted-search-' ~ random()) %}
{% set _color_mode = color_mode|default('') %}
{% set _title = title|default('') %}
{% set _description = description|default('') %}
{% set _search_input = search_input|default({}) %}
{% set _search_label = search_label|default('') %}
{% set _search_helper = search_helper|default('') %}
{% set _search_button = search_button|default({}) %}
{% set _suggestion_label = suggestion_label|default({}) %}
{% set _suggestion = suggestion|default({}) %}

{% set _helper_id = _id ~ '-helper' %}
{% set _suggestion_label_id = _id ~ '-suggestion-label' %}

{# Internal logic - Process properties #}

{% if _color_mode is not empty %}
  {% set _css_class = _css_class ~ ' ' ~ 'ecl-color-mode--' ~ _color_mode %}
{% endif %}

{% if extra_classes is defined and extra_classes is not empty %}
  {% set _css_class = _css_class ~ ' ' ~ extra_classes %}
{% endif %}

{% if extra_attributes is defined and extra_attributes is not empty and extra_attributes is iterable %}
  {% for attr in extra_attributes %}
    {% if attr.value is defined %}
      {% set _extra_attributes = _extra_attributes ~ ' ' ~ attr.name|e('html_attr') ~ '="' ~ attr.value|e('html_attr') ~ '"' %}
    {% else %}
      {% set _extra_attributes = _extra_attributes ~ ' ' ~ attr.name|e('html_attr') %}
    {% endif %}
  {% endfor %}
{% endif %}

{# Print the result #}

<div
  class="{{ _css_class }}"
  {{ _extra_attributes|raw }}
>
  <div class="ecl-highlighted-search__content">
    {# Title #}
    {% if _title is not empty %}
      <div class="ecl-highlighted-search__title">
        {{- _title -}}
      </div>
    {% endif %}

    {# Description #}
    {% if _description is not empty %}
      <div class="ecl-highlighted-search__description ecl-content-color">
        {{- _description -}}
      </div>
    {% endif %}

    {# Input field and button #}
    {% if _search_input is not empty %}
      <form
        class="ecl-highlighted-search__form"
        role="search"
        {% if _search_helper is not empty %}
          aria-describedby="{{ _helper_id }}"
        {% endif %}
      >
        <div class="ecl-highlighted-search__form-content">
          {% include '@ecl/icon/icon.html.twig' with {
            icon: {
              name: 'magnifying-glass',
              family: 'phosphor',
              size: 'm',
            },
            extra_classes: 'ecl-highlighted-search__form-icon'
          } only %}

          {% include '@ecl/form-group/form-group.html.twig' with {
            label: _search_label|default(_search_input.placeholder|default('')),
            hide_label: true,
            extra_classes: 'ecl-highlighted-search__form-group',
            input: _search_input|merge({
              width: 'l',
              input_type: 'search',
              extra_classes: ('ecl-highlighted-search__form-input ' ~ _search_input.extra_classes|default(''))|trim,
            }),
          } only %}

          {% set _default_button = {
              size: 'm',
              variant: 'primary',
              style: 'highlight',
              type: 'submit',
            }
          %}
          {% include '@ecl/button/button.html.twig' with _default_button|merge(_search_button)|merge({
            extra_classes: ('ecl-highlighted-search__form-button ' ~ _search_button.extra_classes|default(''))|trim,
          }) only %}
        </div>
        
        {% if _search_helper is not empty %}
          <div class="ecl-highlighted-search__form-helper" id="{{ _helper_id }}">
            {{- _search_helper -}}
          </div>
        {% endif %}
      </form>
    {% endif %}

    {# Suggestion #}
    {% if _suggestion is not empty %}
      <div class="ecl-highlighted-search__suggestion">
        {% if _suggestion_label is not empty %}
          <span class="ecl-highlighted-search__suggestion-label" id="{{ _suggestion_label_id }}">
            {{- _suggestion_label -}}
          </span>
        {% endif %}

        {% include '@ecl/tag/tag-set.html.twig' with _suggestion|merge({
          extra_classes: ('ecl-highlighted-search__suggestion-list ' ~ _suggestion.extra_classes|default(''))|trim,
          extra_attributes: _suggestion.extra_attributes|default([])|merge(
            _suggestion_label is not empty ? [{ name: 'aria-labelledby', value: _suggestion_label_id }] : []
          ),
        }) only %}
      </div>
    {% endif %}
  </div>
</div>

{% endapply %}
