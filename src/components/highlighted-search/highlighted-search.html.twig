{% apply spaceless %}

{#
  Parameters:
    - "id" (string) (default: random) Unique id for the component
    - "color_mode" (string) The color mode name
    - "background_color" (string) (default: 'dark') Background color; can be 'dark', 'light'
    - "horizontal_alignment" (string) (default: 'center') Content alignment (horizontal); can be 'center', 'left'
    - "full_width" (boolean) (default: false) Full width highlighted search (inside the grid)
    - "title" (string) (default: '') Title of highlighted search
    - "description" (string) (default: '') Description of highlighted search
    - "search_fields" (array) (default: []) Fields of the search form, following ECL Form group structure
      - "label" (string) Label of the field
      - "hide_label" (boolean) (default: false) Hide the label visually (kept for screen readers)
      - "helper_text" (string) (default: '') Helper text of the field
      - "input" (object) Field, following ECL Text input, ECL Select or ECL Datepicker structure
        - "input_type" (string) Type of the field; can be 'text', 'select', 'datepicker'
    - "search_button" (object) (default: {}) Search button, following ECL Button structure
    - "suggestion_label" (string) (default: '') Label for the suggestions
    - "suggestion" (object) (default: {}) List of tags, following the ECL Tag Set structure
    - "extra_classes" (string) (default: '')
    - "extra_attributes" (optional) (array) (default: [])
      - "name" (string) Attribute name, eg. 'data-test'
      - "value" (optional) (string) Attribute value, eg: 'data-test-1'
    - "form_extra_attributes" (optional) (array) (default: []): extra attributes, added at the form level.
      Defaults to a GET method, pass a 'method' attribute here to override it.
      - "name" (string) Attribute name, eg. 'action'
      - "value" (optional) (string) Attribute value, eg: 'action-url'
#}

{# DEPRECATED
- "search_input" (object) (default: {}) Search field, following ECL Text Input structure (replaced by "search_fields")
- "search_helper" (string) (default: '') Search helper, for additional information (replaced by "search_fields.helper_text")
#}

{# Internal properties #}

{% set _css_class = 'ecl-highlighted-search' %}
{% set _extra_attributes = '' %}
{% set _form_extra_attributes = '' %}
{% set _form_has_method = false %}

{% set _id = id|default('ecl-highlighted-search-' ~ random()) %}
{% set _color_mode = color_mode|default('') %}
{% set _background_color = background_color|default('dark') %}
{% set _horizontal_alignment = horizontal_alignment|default('center') %}
{% set _full_width = full_width|default(false) %}
{% set _title = title|default('') %}
{% set _description = description|default('') %}
{% set _search_fields = search_fields|default([]) %}
{% set _search_button = search_button|default({}) %}
{% set _suggestion_label = suggestion_label|default('') %}
{% set _suggestion = suggestion|default({}) %}

{% set _title_id = _id ~ '-title' %}

{# Backward compatibility: legacy search input, used when no search fields are provided #}
{% if _search_fields is empty and search_input is defined and search_input is not empty %}
  {% set _search_fields = [{
    label: search_input.placeholder|default(_search_button.label|default('')),
    hide_label: true,
    helper_text: search_helper|default(''),
    input: search_input|merge({ input_type: 'text' }),
  }] %}
{% endif %}

{# Internal logic - Process properties #}

{% if _color_mode is not empty %}
  {% set _css_class = _css_class ~ ' ' ~ 'ecl-color-mode--' ~ _color_mode %}
{% endif %}

{% set _css_class = _css_class ~ ' ecl-highlighted-search--' ~ _background_color %}

{% if _horizontal_alignment != 'center' %}
  {% set _css_class = _css_class ~ ' ecl-highlighted-search--h' ~ _horizontal_alignment %}
{% endif %}

{% if _full_width %}
  {% set _css_class = _css_class ~ ' ecl-highlighted-search--full-width' %}
{% endif %}

{% if extra_classes is defined and extra_classes is not empty %}
  {% set _css_class = _css_class ~ ' ' ~ extra_classes %}
{% endif %}

{% if extra_attributes is defined and extra_attributes is not empty and extra_attributes is iterable %}
  {% for attr in extra_attributes %}
    {% if attr.value is defined %}
      {% set _extra_attributes = _extra_attributes ~ ' ' ~ attr.name|e('html_attr') ~ '="' ~ attr.value|e('html_attr') ~ '"' %}
    {% else %}
      {% set _extra_attributes = _extra_attributes ~ ' ' ~ attr.name|e('html_attr') %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if form_extra_attributes is defined and form_extra_attributes is not empty and form_extra_attributes is iterable %}
  {% for attr in form_extra_attributes %}
    {% if attr.name == 'method' %}
      {% set _form_has_method = true %}
    {% endif %}
    {% if attr.value is defined %}
      {% set _form_extra_attributes = _form_extra_attributes ~ ' ' ~ attr.name|e('html_attr') ~ '="' ~ attr.value|e('html_attr') ~ '"' %}
    {% else %}
      {% set _form_extra_attributes = _form_extra_attributes ~ ' ' ~ attr.name|e('html_attr') %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if not _form_has_method %}
  {% set _form_extra_attributes = ' method="GET"' ~ _form_extra_attributes %}
{% endif %}

{# Print the result #}

<div
  class="{{ _css_class }}"
  {{ _extra_attributes|raw }}
>
  {% if _full_width %}
  <div class="ecl-container">
  {% endif %}
  <div class="ecl-highlighted-search__content">
    {% if _title is not empty or _description is not empty %}
      <div class="ecl-highlighted-search__info">
        {# Title #}
        {% if _title is not empty %}
          <div class="ecl-highlighted-search__title" id="{{ _title_id }}">
            {{- _title -}}
          </div>
        {% endif %}

        {# Description #}
        {% if _description is not empty %}
          <div class="ecl-highlighted-search__description ecl-content-color">
            {{- _description -}}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {# Form and button #}
    {% if _search_fields is not empty %}
      <form
        class="ecl-highlighted-search__form"
        role="search"
        {% if _title is not empty %}
          aria-labelledby="{{ _title_id }}"
        {% endif %}
        {{ _form_extra_attributes|raw }}
      >
        <div class="ecl-highlighted-search__form-content">
          <div class="ecl-highlighted-search__fields">
            {% for _field in _search_fields %}
              {% set _field_input = _field.input|default({}) %}
              {% set _field_type = _field_input.input_type|default('text') %}
              {% if _field_type not in ['select', 'datepicker'] %}
                {% set _field_type = 'text' %}
              {% endif %}

              <div class="ecl-highlighted-search__field ecl-highlighted-search__field--{{ _field_type }}">
                {% if _field_type == 'text' %}
                  {% include '@ecl/icon/icon.html.twig' with {
                    icon: {
                      name: 'magnifying-glass',
                      family: 'phosphor',
                      size: 'm',
                    },
                    extra_classes: 'ecl-highlighted-search__form-icon'
                  } only %}
                {% endif %}

                {% include '@ecl/form-group/form-group.html.twig' with _field|merge({
                  extra_classes: ('ecl-highlighted-search__form-group ' ~ _field.extra_classes|default(''))|trim,
                  input: _field_input|merge({
                    id: _field_input.id|default(_id ~ '-field-' ~ loop.index),
                    width: 'l',
                    input_type: _field_type == 'text' ? 'search' : _field_type,
                    extra_classes: ('ecl-highlighted-search__form-' ~ (_field_type == 'text' ? 'input' : _field_type) ~ ' ' ~ _field_input.extra_classes|default(''))|trim,
                  }),
                }) only %}
              </div>
            {% endfor %}
          </div>

          {# Button #}
          {% set _default_button = {
              size: 'm',
              variant: 'primary',
              style: _background_color == 'light' ? 'highlight' : 'highlight-inverted',
              type: 'submit',
            }
          %}
          {% include '@ecl/button/button.html.twig' with _default_button|merge(_search_button)|merge({
            extra_classes: ('ecl-highlighted-search__form-button ' ~ _search_button.extra_classes|default(''))|trim,
          }) only %}
        </div>
      </form>
    {% endif %}

    {# Suggestion #}
    {% if _suggestion is not empty %}
      <div class="ecl-highlighted-search__suggestion">
        {% if _suggestion_label is not empty %}
          <span class="ecl-highlighted-search__suggestion-label">
            {{- _suggestion_label -}}
          </span>
        {% endif %}

        {% include '@ecl/tag/tag-set.html.twig' with _suggestion|merge({
          extra_classes: ('ecl-highlighted-search__suggestion-list ' ~ _suggestion.extra_classes|default(''))|trim,
        }) only %}
      </div>
    {% endif %}
  </div>
  {% if _full_width %}
  </div>
  {% endif %}
</div>

{% endapply %}
