exports[`Form group  > with Datepicker > renders correctly 1`] = `
<jest>
  <div
    class="ecl-form-group"
  >
    <label
      class="ecl-form-label"
      for="example-input-id-1"
      id="example-input-id-1-label"
    >
      Label
      <span
        class="ecl-form-label__required"
      >
        (required)
      </span>
      <div
        class="ecl-help-block--hidden"
      >
        Format: dd-mm-yyyy
      </div>
    </label>
    <div
      aria-hidden="true"
      class="ecl-help-block"
      id="example-input-id-1-helper"
    >
      Format: dd-mm-yyyy
    </div>
    <div
      aria-describedby="example-input-id-1-helper"
      class="ecl-datepicker ecl-datepicker--m"
      data-ecl-auto-init="Datepicker"
      data-ecl-datepicker-toggle=""
      data-placeholder="DD-MM-YYYY"
      data-value="2025-08-30 14:13:48 Europe/Brussels"
    >
      <duet-date-picker
        first-day-of-week="1"
        identifier="example-input-id-1"
        max="2026-08-30"
        min="2024-06-15"
        name="example-input-name-1"
        required=""
      />
    </div>
  </div>
</jest>
`;

