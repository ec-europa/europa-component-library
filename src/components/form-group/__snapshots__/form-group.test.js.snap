exports[`Form group  > with Radio > renders correctly 1`] = `
<jest>
  <fieldset
    aria-required="true"
    class="ecl-form-group"
    role="radiogroup"
  >
    <legend
      class="ecl-form-label"
      id="radio-default-label"
    >
      Select your country
      <span
        class="ecl-form-label__required"
      >
        (required)
      </span>
      <div
        class="ecl-help-block--hidden"
      >
        Optional help text
      </div>
    </legend>
    <div
      aria-hidden="true"
      class="ecl-help-block"
      id="radio-default-helper"
    >
      Optional help text
    </div>
    <div
      class="ecl-radio"
    >
      <input
        class="ecl-radio__input"
        id="radio-default-1"
        name="radio-group-1"
        required=""
        type="radio"
        value="lu"
      />
      <label
        class="ecl-radio__label"
        for="radio-default-1"
      >
        <span
          class="ecl-radio__box"
        >
          <span
            class="ecl-radio__box-inner"
          />
        </span>
        <span
          class="ecl-radio__text"
        >
          Luxembourg
        </span>
      </label>
    </div>
    <div
      class="ecl-radio"
    >
      <input
        class="ecl-radio__input"
        id="radio-default-2"
        name="radio-group-1"
        required=""
        type="radio"
        value="be"
      />
      <label
        class="ecl-radio__label"
        for="radio-default-2"
      >
        <span
          class="ecl-radio__box"
        >
          <span
            class="ecl-radio__box-inner"
          />
        </span>
        <span
          class="ecl-radio__text"
        >
          Belgium
        </span>
      </label>
    </div>
    <div
      class="ecl-radio ecl-radio--disabled"
    >
      <input
        class="ecl-radio__input"
        disabled=""
        id="radio-default-3"
        name="radio-group-1"
        required=""
        type="radio"
        value="fr"
      />
      <label
        class="ecl-radio__label ecl-radio__label--disabled"
        for="radio-default-3"
      >
        <span
          class="ecl-radio__box ecl-radio__box--disabled"
        >
          <span
            class="ecl-radio__box-inner"
          />
        </span>
        <span
          class="ecl-radio__text"
        >
          France (disabled)
        </span>
      </label>
    </div>
    <div
      class="ecl-radio"
    >
      <input
        class="ecl-radio__input"
        id="radio-default-4"
        name="radio-group-1"
        required=""
        type="radio"
        value="lorem"
      />
      <label
        class="ecl-radio__label"
        for="radio-default-4"
      >
        <span
          class="ecl-radio__box"
        >
          <span
            class="ecl-radio__box-inner"
          />
        </span>
        <span
          class="ecl-radio__text"
        >
          Lorem ipsum dolor sit amet, 
          <a
            href="/example"
          >
            consectetur adipiscing elit
          </a>
          . Nullam suscipit eros gravida arcu aliquet, sed finibus nisl egestas. Cras sed purus nec turpis eleifend dignissim a in massa.
        </span>
      </label>
    </div>
  </fieldset>
</jest>
`;

