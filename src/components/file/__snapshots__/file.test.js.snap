exports[`File Thumbnail renders correctly 1`] = `
<jest>
  <div
    class="ecl-file ecl-file--thumbnail"
    data-ecl-auto-init="FileDownload"
    data-ecl-file=""
    id="ecl-file-with-thumbnail"
  >
    <article
      class="ecl-file__container"
    >
      <div
        class="ecl-file__info"
      >
        <picture
          class="ecl-picture ecl-file__picture"
        >
          <img
            alt=""
            class="ecl-file__image"
            src="https://inno-ecl.s3.amazonaws.com/media/examples/example-image.jpg"
          />
        </picture>
        <div
          class="ecl-file__content"
        >
          <div
            class="ecl-file__labels"
          >
            <div
              class="ecl-file__label"
            >
              <span
                class="ecl-label ecl-label--highlight"
              >
                highlighted
              </span>
            </div>
          </div>
          <div
            class="ecl-file__title"
            id="ecl-file-with-thumbnail-title"
          >
            <a
              class="ecl-link ecl-link--standalone"
              href="/example"
            >
              State of the Union 2018 brochure
            </a>
          </div>
          <div
            class="ecl-file__description"
          >
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer quis lorem tellus. Nullam sollicitudin suscipit diam, ac blandit ipsum tempor consectetur. Duis vitae pulvinar turpis. Donec maximus pharetra ex a ultricies.
          </div>
          <ul
            class="ecl-file__primary-meta"
          >
            <li
              class="ecl-file__primary-meta-item"
            >
              META INFO
            </li>
            <li
              class="ecl-file__primary-meta-item"
            >
              DD Month YYYY
            </li>
          </ul>
        </div>
      </div>
      <footer
        class="ecl-file__footer"
      >
        <button
          aria-controls="ecl-file-with-thumbnail-translations"
          aria-expanded="false"
          class="ecl-button ecl-button--tertiary ecl-button--neutral ecl-file__translation-toggle"
          data-ecl-file-translation-toggle=""
          type="button"
        >
          <span
            class="ecl-button__container"
          >
            <span
              class="ecl-button__label"
              data-ecl-label="true"
            >
              <span
                class="ecl-file__language"
                id="ecl-file-with-thumbnail-lang"
              >
                English
              </span>
            </span>
            <span
              aria-hidden="true"
              class="wt-icon-phosphor--caret-down ecl-icon ecl-icon--fluid ecl-button__icon ecl-icon-phosphor--caret-down"
              data-ecl-icon=""
            />
          </span>
        </button>
        <div
          class="ecl-file__action"
        >
          <a
            aria-labelledby="ecl-file-with-thumbnail-link-label-text ecl-file-with-thumbnail-title ecl-file-with-thumbnail-lang ecl-file-with-thumbnail-meta"
            class="ecl-link ecl-link--standalone ecl-link--brand ecl-link--icon ecl-file__download"
            href="/example"
            id="ecl-file-with-thumbnail-link"
          >
            <span
              class="ecl-link__label"
              id="ecl-file-with-thumbnail-link-label"
            >
              <span
                id="ecl-file-with-thumbnail-link-label-text"
              >
                Download
              </span>
              <span
                class="ecl-file__meta"
                id="ecl-file-with-thumbnail-meta"
              >
                 (16.2 MB - PDF)
              </span>
            </span>
            <span
              aria-hidden="true"
              class="wt-icon-phosphor--download-simple ecl-icon ecl-icon--fluid ecl-link__icon ecl-icon-phosphor--download-simple"
            />
          </a>
        </div>
      </footer>
    </article>
    <ul
      class="ecl-file__translation-list"
      hidden=""
      id="ecl-file-with-thumbnail-translations"
    >
      <li
        class="ecl-file__translation-item"
      >
        <div
          class="ecl-file__translation-info"
        >
          <div
            class="ecl-file__translation-title"
            id="ecl-file-with-thumbnail-translation-0-title"
            lang="bg"
          >
            български
          </div>
          <div
            class="ecl-file__translation-meta"
            id="ecl-file-with-thumbnail-translation-0-meta"
          >
            (15.7 MB - PDF)
          </div>
        </div>
        <div
          class="ecl-file__translation-action"
        >
          <a
            aria-labelledby="ecl-file-with-thumbnail-translation-0-link-label ecl-file-with-thumbnail-title ecl-file-with-thumbnail-translation-0-title ecl-file-with-thumbnail-translation-0-meta"
