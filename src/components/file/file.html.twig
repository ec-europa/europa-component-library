{% import _self as file %}
{% apply spaceless %}

{#
  Parameters:
  - "id" (string) (default: random) Unique id for the file component
  - "icon" (object) (default: {}): object of type Icon; indicates the file type
  - "title" (string|object) (default: '') Plain text title or or link object following ECL Link structure
  - "description" (string) (default: '') Description text
  - "language" (string) (default: '') Language label for the file
  - "meta" (string) (default: '') File metadata (size, format, etc.)
  - "primary_meta" (array) (default: []) Primary meta of the file
  - "download" (object) (default: {}): Download link, following ECL Link structure
  - "download_attribute" (boolean) (default: false) Add the HTML download attribute to the download link
  - "picture" (object) (default: {}): Thumbnail image, following ECL Picture structure
  - "label" (array) (default: []) Array of ECL Label objects (also supported as a single label object)
  - "lists" (array) (default: []) Array of ECL Description list objects
  - "translation" (array) (default: []) Translation panel for multiple language versions:
    - "toggle" (object) (default: {}): Toggle button, following ECL Button structure
    - "download_attribute" (boolean) (default: false) Add download attribute to all translation links
    - "items" (array) (default: []) Translation items:
      - "title" (string) (default: '') Language label
      - "meta" (string) (default: '') File metadata for this language version
      - "lang" (string) (default: '') Language code (ISO 639-1)
      - "download" (object) Download link override for this language (falls back to parent download)
      - "download_attribute" (boolean) Download attribute override for this language
  - "extra_classes" (string) (default: '') Extra classes (space separated)
  - "extra_attributes" (array) (default: []) Extra attributes
    - "name" (string) Attribute name, eg. 'data-test'
    - "value" (string) Attribute value, eg: 'data-test-1'
#}

{# DEPRECATED 
- "variant" (string) (default: 'default') Display variant; can be 'default' or 'thumbnail'; not used anmore
- "detail_meta" (array) (default: []) Additional metadata for the thumbnail variant; replaced by 'primary_meta'
#}
{% set _detail_meta = detail_meta|default([]) %}
{% set _variant = variant|default('default') %}

{# Internal properties #}

{% set _css_class = 'ecl-file' %}
{% set _id = id|default('ecl-file-' ~ random()) %}
{% set _icon = icon|default({}) %}
{% set _title = title|default('') %}
{% set _language = language|default('') %}
{% set _meta = meta|default([]) %}
{% set _label = label|default({}) %}
{% set _lists = lists|default([]) %}
{% set _download = download|default({}) %}
{% set _download_attribute = download_attribute|default(false) %}
{% set _primary_meta = primary_meta|default([]) %}
{% set _translation = translation|default([]) %}
{% set _picture = picture|default({}) %}
{% set _description = description|default('') %}

{% set _extra_attributes = 'data-ecl-file id="' ~ _id ~ '"' %}
{% set _lang_id = _id ~ '-lang' %}
{% set _title_id = _id ~ '-title' %}
{% set _meta_id = _id ~ '-meta' %}
{% set _download_id = _id ~ '-link' %}
{% set _download_text_id = _id ~ '-link-label-text' %}
{% set _translation_list_id = _id ~ '-translations' %}

{% if _label.label is defined %}
  {% set _labels = [_label] %}
{% elseif _label[0] is defined %}
  {% set _labels = _label %}
{% endif %}

{% if _translation is not empty and _translation.items is not empty and _translation.items is iterable %}
  {% set _extra_attributes = _extra_attributes ~ ' ' ~ 'data-ecl-auto-init="FileDownload"' %}
{% endif %}

{# Backward compatibility #}
{% if _detail_meta is not empty %}
  {% set _primary_meta = _detail_meta %}
{% endif %}

{# Internal logic - Process properties #}
{% if _variant != 'default' %}
  {% set _css_class = _css_class ~ ' ' ~ _css_class ~ '--' ~ _variant %}
{% endif %}

{% if extra_classes is defined and extra_classes is not empty %}
  {% set _css_class = _css_class ~ ' ' ~ extra_classes %}
{% endif %}

{% if extra_attributes is defined and extra_attributes is not empty and extra_attributes is iterable %}
  {% for attr in extra_attributes %}
    {% if attr.value is defined %}
      {% set _extra_attributes = _extra_attributes ~ ' ' ~ attr.name|e('html_attr') ~ '="' ~ attr.value|e('html_attr') ~ '"' %}
    {% else %}
      {% set _extra_attributes = _extra_attributes ~ ' ' ~ attr.name|e('html_attr') %}
    {% endif %}
  {% endfor %}
{% endif %}

{# Macro: render a file download link #}
{% macro download_link(download, link_id, labelledby, base_class, add_download_attr, hreflang, branded) %}
  {% set _attrs = download.extra_attributes|default([])|merge([
    { name: 'id', value: link_id },
    { name: 'aria-labelledby', value: labelledby },
  ]) %}
  {% if hreflang is not empty %}
    {% set _attrs = _attrs|merge([{ name: 'hreflang', value: hreflang }]) %}
  {% endif %}
  {% if add_download_attr %}
    {% set _attrs = _attrs|merge([{ name: 'download' }]) %}
  {% endif %}

  {% set _classes = base_class %}
  {% if download.extra_classes is not empty %}
    {% set _classes = _classes ~ ' ' ~ download.extra_classes %}
  {% endif %}

  {% set _link = download.link|default({})|merge({ type: 'standalone' }) %}
  {% if branded %}
    {% set _link = _link|merge({ branded: true }) %}
  {% endif %}

  {% include '@ecl/link/link.html.twig' with download|merge({
    link: _link,
    icon: download.icon|default({})|merge({
      name: 'download-simple',
      family: 'phosphor',
      size: 'fluid',
    }),
    extra_classes: _classes,
    extra_attributes: _attrs,
  }) only %}
{% endmacro %}

{# Print the result #}

<div
  class="{{ _css_class }}"
  {{ _extra_attributes|raw }}
>
  <article class="ecl-file__container">
    {# File info #}
    <div class="ecl-file__info">
      {# Picture #}
      {% if _picture is not empty and _picture.img is not empty %}
        {% include '@ecl/picture/picture.html.twig' with {
          picture: _picture,
          extra_classes: 'ecl-file__picture',
          extra_image_classes: 'ecl-file__image',
        } only %}

      {# Icon #}
      {% elseif _icon is not empty %}
        <div class="ecl-file__icon-box">
          {% include '@ecl/icon/icon.html.twig' with {
            icon: _icon|merge({
              size: _icon.size|default('l'),
            }),
            extra_classes: 'ecl-file__icon',
          } only %}
        </div>
      {% endif %}

      {% if _title is not empty or _primary_meta is not empty %}
        <div class="ecl-file__content">
          {# Label #}
          {% if _labels is not empty %}
            <div class="ecl-file__labels">
              {% for _label in _labels %}
                <div class="ecl-file__label">
                  {% include '@ecl/label/label.html.twig' with _label only %}
                </div>
              {% endfor %}
            </div>
          {% endif %}

          {# Title #}
          {% if _title is not empty %}
            <div class="ecl-file__title" id="{{ _title_id }}">
            {%- if _title.link is defined -%}
              {% include '@ecl/link/link.html.twig' with {
                link: _title.link|merge({ 'type' : 'standalone' }),
              } only %}
            {%- else -%}
              {{ _title }}
            {%- endif -%}
            </div>
          {% endif %}

          {# Description #}
          {% if _description is not empty %}
            <div class="ecl-file__description">{{ _description }}</div>
          {% endif %}

          {# Primary meta #}
          {% if _primary_meta is not empty and _primary_meta is iterable %}
            <ul class="ecl-file__primary-meta">
              {% for _meta_item in _primary_meta %}
                <li class="ecl-file__primary-meta-item">{{ _meta_item }}</li>
              {% endfor %}
            </ul>
          {% endif %}

          {# List #}
          {% if _lists is not empty and _lists is iterable %}
            <div class="ecl-file__lists">
              {% for _list in _lists %}
                {% include '@ecl/description-list/description-list.html.twig' with _list only %}
              {% endfor %}
            </div>
          {% endif %}
        </div>

      {% endif %}
      
    </div>
    
    {# File footer #}
    <footer class="ecl-file__footer">
      {# Translation toggle #}
      {% set _toggle_label = '' %}
      {% if _language is not empty %}
        {% set _toggle_label %}
          <span class="ecl-file__language" id="{{ _lang_id }}">{{ _language }}</span>
        {% endset %}
      {% endif %}

      {% if _toggle_label is not empty %}
        {% if _translation is not empty %}
          {% include '@ecl/button/button.html.twig' with {
            label: _toggle_label,
            variant: 'tertiary',
            style: 'neutral',
            type: 'button',
            size: 'l',
            icon: {
              name: 'caret-down',
              family: 'phosphor',
              size: 'fluid',
            },
            extra_classes: 'ecl-file__translation-toggle',
            extra_attributes: [
              { name: 'data-ecl-file-translation-toggle' },
              { name: 'aria-expanded', value: 'false' },
              { name: 'aria-controls', value: _translation_list_id },
            ],
          } only %}
        {% else %}
          {{- _toggle_label -}}
        {% endif %}
      {% endif %}

      {# Actions #}
      <div class="ecl-file__action">
        {% set _download_label %}
          <span id="{{ _download_text_id }}">{{- _download.link.label|default('') -}}</span>
          {%- if _meta is not empty -%}
            <span class="ecl-file__meta" id="{{ _meta_id }}"> {{ _meta }}</span>
          {% endif %}
        {% endset %}

        {{ file.download_link(
          _download|merge({ link: (_download.link|default({}))|merge({ label: _download_label }) }),
          _download_id,
          _download_text_id ~ ' ' ~ _title_id ~ ' ' ~ _lang_id ~ ' ' ~ _meta_id,
          'ecl-file__download',
          _download_attribute,
          '',
          true
        ) }}
      </div>
    </footer>
  </article>

  {# Translations #}
  {% if _translation.items is not empty and _translation.items is iterable %}
    <ul class="ecl-file__translation-list" id="{{ _translation_list_id }}" hidden>
      {% for key, _item in _translation.items %}
        {% set _translation_id = _id ~ '-translation-' ~ key %}
        {% set _translation_title_id = _translation_id ~ '-title' %}
        {% set _translation_meta_id = _translation_id ~ '-meta' %}

        <li class="ecl-file__translation-item">
          {# Translation info #}
          <div class="ecl-file__translation-info">
            {% if _item.title is not empty %}
              <div
                class="ecl-file__translation-title"
                id="{{ _translation_title_id }}"
              {% if _item.lang is not empty %}
                lang="{{ _item.lang }}"
              {% endif %}
              >
                {{- _item.title -}}
              </div>
            {% endif %}

            {% if _item.meta is not empty %}
              <div class="ecl-file__translation-meta" id="{{ _translation_meta_id }}">
                {{- _item.meta -}}
              </div>
            {% endif %}
          </div>

          {# Translation actions #}
          <div class="ecl-file__translation-action">
            {% set _translation_link_id = _translation_id ~ '-link' %}
            {% set _translation_item_download = _item.download is not empty ? _item.download : _download %}
            {% set _translation_item_download_attribute = _item.download_attribute is defined ? _item.download_attribute : _translation.download_attribute|default(false) %}
            {{ file.download_link(
              _translation_item_download,
              _translation_link_id,
              _translation_link_id ~ '-label ' ~ _title_id ~ ' ' ~ _translation_title_id ~ ' ' ~ _translation_meta_id,
              'ecl-file__translation-download',
              _translation_item_download_attribute,
              _item.lang|default(''),
              false
            ) }}
          </div>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</div>

{% endapply %}
