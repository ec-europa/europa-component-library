exports[`Source > Default > renders correctly 1`] = `
<jest>
  <div
    class="ecl-source"
  >
    <span
      class="ecl-source__label"
    >
      Sources:
    </span>
    <ul
      class="ecl-source__list"
    >
      <li
        class="ecl-source__item"
      >
        <a
          class="ecl-link ecl-source__link"
          href="/example"
        >
          Eurostat
        </a>
      </li>
      <li
        class="ecl-source__item"
      >
        <a
          class="ecl-link ecl-link--icon ecl-source__link"
          href="/example"
        >
          <span
            class="ecl-link__label"
          >
            DG CNECT
          </span>
           
          <span
            aria-hidden="false"
            class="wt-icon-phosphor--arrow-square-out ecl-icon ecl-icon--xs ecl-link__icon ecl-icon-phosphor--arrow-square-out"
          />
        </a>
      </li>
      <li
        class="ecl-source__item"
      >
        <span
          class="ecl-source__text"
        >
          European Commission
        </span>
      </li>
    </ul>
  </div>
</jest>
`;

