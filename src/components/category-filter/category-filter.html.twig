{% apply spaceless %}

{#
  Parameters:
  - "color_mode" (string) The color mode name
  - "label": (string) (default: ''): Aria label provided for accessibility
  - "id": (string) (default: randomized string): Unique id for the category filter
  - "items": (associative array) (default: {}): The menu items - format: [
    {
      "label": "Home",
      "path": "/example",
      "current": false,
    },
    {
      "label": "Item 1",
      "path": "/example",
      "children": [
        {
          "label": "Item 1.1",
          "path": "/example",
          "current": false,
        },
        {
          "label": "Item 1.2",
          "path": "/example"
        },
      },
    },
  }],
  - "expand_all" (associative array) (default: {}): Button for expanding all the items; following ECL button structure
  - "collapse_all" (associative array) (default: {}): Button for collapsing all the items; following ECL button structure
  - "extra_classes" (string) (default: '') Extra classes (space separated) for the nav element
  - "extra_attributes" (optional) (array) (default: []) Extra attributes for the nav element
    - "name" (string) Attribute name, eg. 'data-test'
    - "value" (optional) (string) Attribute value, eg: 'data-test-1'
#}

{# Internal properties #}

{% set _color_mode = color_mode|default('') %}
{% set _css_class = 'ecl-category-filter' %}
{% set _extra_attributes = '' %}
{% set _label = label|default('') %}
{% set _id = id|default('ecl-category-filter-' ~ random()) %}
{% set _expand_all = expand_all|default({}) %}
{% set _collapse_all = collapse_all|default({}) %}

{# Internal logic - Process properties #}

{% if _color_mode is not empty %}
  {% set _css_class = _css_class ~ ' ' ~ 'ecl-color-mode--' ~ _color_mode %}
{% endif %}

{% if extra_classes is defined and extra_classes is not empty %}
  {% set _css_class = _css_class ~ ' ' ~ extra_classes %}
{% endif %}

{% if extra_attributes is defined and extra_attributes is not empty and extra_attributes is iterable %}
  {% for attr in extra_attributes %}
    {% if attr.value is defined %}
      {% set _extra_attributes = _extra_attributes ~ ' ' ~ attr.name|e('html_attr') ~ '="' ~ attr.value|e('html_attr') ~ '"' %}
    {% else %}
      {% set _extra_attributes = _extra_attributes ~ ' ' ~ attr.name|e('html_attr') %}
    {% endif %}
  {% endfor %}
{% endif %}

{# Print the result #}

<nav
  class="{{ _css_class }}"
  data-ecl-category-filter
  data-ecl-auto-init="CategoryFilter"
  {% if _label is not empty %}
    aria-label="{{ _label }}"
  {% endif %}
  {{ _extra_attributes|raw }}
>
  {% if _expand_all is not empty or _collapse_all is not empty %}
    <div class="ecl-category-filter__controls">
    {% if _expand_all is not empty %}
      {% include '@ecl/button/button.html.twig' with _expand_all|merge({
        variant: _expand_all.variant|default('tertiary'),
        type: 'button',
        extra_classes: 'ecl-category-filter__expand-all',
        extra_attributes: _expand_all.extra_attributes|default([])|merge([
          { name: 'data-ecl-category-filter-expand-all' },
        ]),
      }) only %}
    {% endif %}
    {% if _collapse_all is not empty %}
      {% include '@ecl/button/button.html.twig' with _collapse_all|merge({
        variant: _collapse_all.variant|default('tertiary'),
        type: 'button',
        extra_classes: 'ecl-category-filter__collapse-all',
        extra_attributes: _collapse_all.extra_attributes|default([])|merge([
          { name: 'data-ecl-category-filter-collapse-all' },
        ]),
      }) only %}
    {% endif %}
    </div>
  {% endif %}
  <ul class="ecl-category-filter__list">
  {% if items is defined and items is not empty and items is iterable %}
    {% include '@ecl/category-filter/category-filter-items.html.twig' with {
      items: items,
      id: _id,
    } only %}
  {% endif %}
  </ul>
</nav>

{% endapply %}
