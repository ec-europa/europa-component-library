exports[`Tag Removable renders correctly 1`] = `
<jest>
  <button
    class="ecl-tag ecl-tag--removable"
    type="button"
  >
    <span
      class="ecl-tag__label"
    >
      Removable tag
    </span>
    <span
      class="ecl-tag__icon"
    >
      <span
        aria-hidden="false"
        class="wt-icon-phosphor--x ecl-icon ecl-icon--xs ecl-tag__icon-close ecl-icon-phosphor--x"
        role="img"
        title="Dismiss"
      />
    </span>
  </button>
</jest>
`;

