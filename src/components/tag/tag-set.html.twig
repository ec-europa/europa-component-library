{% apply spaceless %}

{#
  Parameters:
  - "color_mode" (string)
  - "variant" (string) (default: ''): display variant for the tag set. Can be empty or 'prefilter'
  - "items" (array) (default: []): array of Tag
  - "label" (string) (default: '') optional label for the tag set
  - "extra_classes" (string) (default: '')
  - "extra_attributes" (optional) (array) (default: [])
    - "name" (string) Attribute name, eg. 'data-test'
    - "value" (optional) (string) Attribute value, eg: 'data-test-1'
#}

{# Internal properties #}

{% set _color_mode = color_mode|default('') %}
{% set _variant = variant|default('') %}
{% set _items = items|default([]) %}
{% set _label = label|default('') %}
{% set _css_class = 'ecl-tag-set' %}
{% set _extra_attributes = '' %}

{# Internal logic - Process properties #}

{% if _variant is not empty %}
  {% set _css_class = _css_class ~ ' ' ~ 'ecl-tag-set--' ~ _variant %}
{% endif %}

{% if extra_classes is defined and extra_classes is not empty %}
  {% set _css_class = _css_class ~ ' ' ~ extra_classes %}
{% endif %}

{% if extra_attributes is defined and extra_attributes is not empty and extra_attributes is iterable %}
  {% for attr in extra_attributes %}
    {% if attr.value is defined %}
      {% set _extra_attributes = _extra_attributes ~ ' ' ~ attr.name|e('html_attr') ~ '="' ~ attr.value|e('html_attr') ~ '"' %}
    {% else %}
      {% set _extra_attributes = _extra_attributes ~ ' ' ~ attr.name|e('html_attr') %}
    {% endif %}
  {% endfor %}
{% endif %}

{# Print the result #}

<div class="{{ _css_class }}" {{ _extra_attributes|raw }}>
{% if _label is not empty %}
  <span class="ecl-tag-set__label">{{ _label }}</span>
{% endif %}

{% if _items is not empty and _items is iterable %}
  <ul class="ecl-tag-set__list">
    {%- for _item in _items %}
      {% set _item_type = _item.tag.type|default('') %}
      {% if _variant == 'prefilter' %}
        {% set _item_type = 'prefilter' %}
      {% endif %}
      
      <li class="ecl-tag-set__item">
        {% include '@ecl/tag/tag.html.twig' with _item|merge({
          color_mode: _item.color_mode|default(_color_mode),
          tag: _item.tag|default({})|merge({
            type: _item_type,
          }),
        }) only %}
      </li>
    {% endfor -%}
  </ul>
{% endif %}
</div>

{% endapply %}
