{% apply spaceless %}
{#
  Parameters:
    - "title" (string) (default: '') Title of the expandable
    - "sponsor" (string) (default: '') Sponsor of the political adv
    - "more" (string) (default: '') Additional info
    - "more_link" (associative array) Object of the ECL link
    - "toggle_label" (string) (default: '') Not visible, needed for accessibility
    - "lists" (array) (default: []) array of list with illustration objects
    - "separator" (string) (default: "–" )
    - "extra_classes" (string) (default: '')
    - "extra_attributes" (array) (default: []): format: [
        {
          "name" (string) (default: ''),
          "value" (optional) (string)
        ...
      ],

  Blocks:
    - header_content (default: '') Content of the header
    - panel_content (default: '') Content of the hidden panel
#}

{# Internal properties #}

{% set _title = title|default('') %}
{% set _sponsor = sponsor|default('') %}
{% set _more = more|default('') %}
{% set _more_link = more_link|default({}) %}
{% set _toggle_label = toggle_label|default('') %}
{% set _lists = lists|default([]) %}
{% set _panel_id = panel_id|default('ecl-political-adv-panel-' ~ random()) %}
{% set _header_content = header_content|default('') %}
{% set _panel_content = panel_content|default('') %}
{% set _separator = separator|e('html_attr')|default('–') %}
{% set _extra_attributes = '' %}
{% set _css_class = "ecl-political-adv" %}

{# Internal logic - Process properties #}

{% if extra_classes is defined and extra_classes is not empty %}
  {% set _css_class = _css_class ~ ' ' ~ extra_classes %}
{% endif %}

{% if extra_attributes is defined and extra_attributes is not empty and extra_attributes is iterable %}
  {% for attr in extra_attributes %}
    {% if attr.value is defined %}
      {% set _extra_attributes = _extra_attributes ~ ' ' ~ attr.name|e('html_attr') ~ '="' ~ attr.value|e('html_attr') ~ '"' %}
    {% else %}
      {% set _extra_attributes = _extra_attributes ~ ' ' ~ attr.name|e('html_attr') %}
    {% endif %}
  {% endfor %}
{% endif %}

{# Print the result #}

<div
  class="{{ _css_class }}"
  {{ _extra_attributes|raw }}
  data-ecl-auto-init="PoliticalAdv"
>
  <div
    class="ecl-political-adv__header"
    data-ecl-political-adv-header
  >
    <div class="ecl-political-adv__header-text" style="--ecl-political-adv-separator: '{{ _separator }}'">
    {% if _title is not empty %}
      <span  class="ecl-political-adv__title">{{ _title }}</span>
    {% endif %}
    {% if _sponsor is not empty %}
      <span class="ecl-political-adv__sponsor">{{ _sponsor }}</span>
    {% endif %}
    {% if _more is not empty %}
      <span class="ecl-political-adv__more">{{ _more }}</span>
    {% endif %}
    {% if _more_link is not empty %}
      {% include '@ecl/link/link.html.twig' with _more_link|merge({
        extra_classes: _link.extra_classes|default('') ~ 'ecl-political-adv__more-link',
        extra_attributes: _link.extra_attributes|default([])|merge([{
          name: 'data-ecl-political-adv-header-link'
        }]),
      }) only %}
    {% endif %}
      {% block header_content _header_content %}
    </div>
    {% include '@ecl/button/button.html.twig' with {
      hide_label: true,
      label: _toggle_label,
      variant: 'tertiary',
      style: 'neutral',
      size: 'l',
      icon: {
        name: 'corner-arrow',
        transform: 'flip-vertical',
        size: 'm',
      },
      extra_classes: 'ecl-political-adv__toggle',
      extra_attributes: [
        { name: 'aria-controls', value: _panel_id },
        { name: 'aria-expanded', value: 'false' },
        { name: 'data-ecl-political-adv-toggle' },
      ],
    } only %}
  </div>
  <div class="ecl-political-adv__panel" id="{{ _panel_id }}" hidden>
    {% if _lists is not empty %}
      {% for _list in _lists %}
        {% include '@ecl/list-illustration/list-illustration.html.twig' with _list|merge({
          extra_classes: 'ecl-political-adv__list ' ~ (_list.extra_classes ? _list.extra_classes : ''),
        }) only %}
      {% endfor %}
    {% endif %}
    {% block panel_content _panel_content %}
  </div>
</div>

{% endapply %}
