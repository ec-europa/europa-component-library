        <ul
          class="ecl-page-header__meta"
        >
          <li
            class="ecl-page-header__meta-item"
          >
            News article
          </li>
          <li
            class="ecl-page-header__meta-item"
          >
            10 March 2025
          </li>
          <li
            class="ecl-page-header__meta-item"
          >
            <span
              aria-hidden="true"
