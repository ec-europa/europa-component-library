              class="ecl-picture ecl-page-header__picture-thumbnail"
            >
              <img
                alt="Europe flag"
                class="ecl-page-header__description-thumbnail"
                src="https://inno-ecl.s3.amazonaws.com/media/examples/example-image.jpg"
              />
