{% apply spaceless %}
{#
  Parameters:
  - "color_mode" (string) (default: '') Name of the color mode
  - "id" (string) (default: random): Unique id
  - "variant" (string) (default: ''): Display variant; can be '', 'primary'
  - "text_position" (string) (default: 'left'): Text position relative to the media; can be 'left', 'right'
  - "title" (string) (default: ''): Content title
  - "micro_title" (string) (default: ''): Small additional title
  - "description" (string) (default: ''): Content description
  - "media_container" (object) (default: {}): object of type Media container
  - "extra_classes" (string) (default: '')
  - "extra_attributes" (array) (default: []): format: [
      {
        "name" (string) (default: ''),
        "value" (optional) (string)
      ...
    ],
#}

{# Internal properties #}

{% set _css_class = 'ecl-text-media' %}
{% set _css_container_class = 'ecl-text-media__container' %}
{% set _color_mode = color_mode|default('') %}
{% set _id = id|default('ecl-text-media-' ~ random()) %}
{% set _variant = variant|default('') %}
{% set _text_position = text_position|default('left') %}
{% set _title = title|default('') %}
{% set _micro_title = micro_title|default('') %}
{% set _description = description|default('') %}
{% set _media_container = media_container|default({}) %}
{% set _extra_attributes = '' %}

{# Internal logic - Process properties #}

{% if _color_mode is not empty %}
  {% set _css_class = _css_class ~ ' ' ~ 'ecl-color-mode--' ~ _color_mode %}
{% endif %}

{% if _variant is not empty %}
  {% set _css_class = _css_class ~ ' ecl-text-media--' ~ _variant %}
{% endif %}

{% if _text_position != 'left' %}
  {% set _css_container_class = _css_container_class ~ ' ecl-text-media__container--position-' ~ _text_position %}
{% endif %}

{% if extra_classes is defined and extra_classes is not empty %}
  {% set _css_class = _css_class ~ ' ' ~ extra_classes %}
{% endif %}

{% if extra_attributes is defined and extra_attributes is not empty and extra_attributes is iterable %}
  {% for attr in extra_attributes %}
    {% if attr.value is defined %}
      {% set _extra_attributes = _extra_attributes ~ ' ' ~ attr.name|e('html_attr') ~ '="' ~ attr.value|e('html_attr') ~ '"' %}
    {% else %}
      {% set _extra_attributes = _extra_attributes ~ ' ' ~ attr.name|e('html_attr') %}
    {% endif %}
  {% endfor %}
{% endif %}

{# Print the result #}

<article
  class="{{ _css_class }}"
  {{ _extra_attributes|raw }}
>
  <div class="{{ _css_container_class }}">
    <div class="ecl-text-media__item">
      <div class="ecl-text-media__content">
        <div class="ecl-text-media__info">
        {% if _title is not empty %}
          <div class="ecl-text-media__title" id="{{ _id ~ '-title' }}">{{- _title -}}</div>
        {% endif %}
        {% if _description is not empty %}
          <div class="ecl-text-media__description">{{ _description }}</div>
        {% endif %}
        </div>
      {% if _link is not empty and _link.link is defined and _link.link.label is not empty %}
        {% set _link_attributes = _link.extra_attributes|default({}) %}
        {% if _title is not empty %}
          {% set _link_attributes = _link_attributes|merge([
            { name: 'aria-describedby', value: _id ~ '-title' },
            ])
          %}
        {% endif %}
        {% include '@ecl/link/link.html.twig' with _link|merge({
          extra_classes: 'ecl-text-media__link',
          extra_attributes: _link_attributes,
        }) only %}
      {% endif %}
      </div>
    </div>

    {% if _media_container is not empty %}
      <div class="ecl-text-media__item">
      {% include '@ecl/media-container/media-container.html.twig' with _media_container|merge({
        extra_classes: 'ecl-text-media__media_container',
      }) only %}
      </div>
    {% endif %}
  </div>
</article>
{% endapply %}
