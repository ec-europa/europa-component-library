{% apply spaceless %}

{#
  Parameters:
  - "variant" (string) (default: 'info'): could be 'info, 'success', 'warning' or 'error'
  - "icon" (object of type "icon") (default: phosphor icon matching "variant" - 'info', 'check-circle', 'warning' or 'warning-circle')
  - "sr_icon" (string) (default: ''): additional label for the icon; for screen readers
  - "title" (string) (default: '')
  - "description" (string) (default: '')
  - "links" (array) (default: []) Array of ECL Link objects shown below the description
  - "close" (object) (default: phosphor 'x' icon) Close button following ECL Button structure
  - "extra_classes" (string) (default: '') Extra classes (space separated)
  - "extra_attributes" (array) (default: []) Extra attributes
    - "name" (string) Attribute name, eg. 'data-test'
    - "value" (string) Attribute value, eg: 'data-test-1'

  Blocks:
  - "description": content of the notification
#}

{# Internal properties #}

{% set _variant = variant|default('info') %}
{% set _icon = icon|default({}) %}
{% set _default_icon_name = 'info' %}
{% if _variant == 'success' %}
  {% set _default_icon_name = 'check-circle' %}
{% elseif _variant == 'warning' %}
  {% set _default_icon_name = 'warning' %}
{% elseif _variant == 'error' %}
  {% set _default_icon_name = 'warning-circle' %}
{% endif %}
{% set _sr_icon = sr_icon|default('') %}
{% set _title = title|default('') %}
{% set _close = close|default({}) %}
{% set _default_close_icon = { name: 'x', family: 'phosphor' } %}
{% set _links = links|default([]) %}
{% set _description = description|default('') %}
{% set _css_class = 'ecl-notification' %}
{% set _extra_attributes = 'data-ecl-auto-init="Notification"' %}

{# Internal logic - Process properties #}

{% if _variant is not empty %}
  {% set _css_class = _css_class ~ ' ecl-notification--' ~ _variant %}
{% endif %}

{% set _icon = _icon is not empty ? _icon|merge({
  size: _icon.size|default('l'),
}) : {
  name: _default_icon_name,
  family: 'phosphor',
  size: 'l',
} %}

{% if extra_classes is defined and extra_classes is not empty %}
  {% set _css_class = _css_class ~ ' ' ~ extra_classes %}
{% endif %}

{% if extra_attributes is defined and extra_attributes is not empty and extra_attributes is iterable %}
  {% for attr in extra_attributes %}
    {% if attr.value is defined %}
      {% set _extra_attributes = _extra_attributes ~ ' ' ~ attr.name|e('html_attr') ~ '="' ~ attr.value|e('html_attr') ~ '"' %}
    {% else %}
      {% set _extra_attributes = _extra_attributes ~ ' ' ~ attr.name|e('html_attr') %}
    {% endif %}
  {% endfor %}
{% endif %}

{# Print the result #}

<div
  class="{{ _css_class }}"
  data-ecl-notification
  role="alert"
  {{ _extra_attributes|raw }}
>
  {% include '@ecl/icon/icon.html.twig' with {
    icon: _icon,
    as_image: true,
    extra_accessibility: not _sr_icon ? {} : {
      title: _sr_icon,
    },
    extra_classes: 'ecl-notification__icon',
  } only %}
  <div class="ecl-notification__content">
  {% if _close is not empty %}
    {% include '@ecl/button/button.html.twig' with _close|merge({
      type: 'button',
      size: 'm',
      variant: 'tertiary',
      style: 'neutral',
      icon: _close.icon|default([]) is not empty ? _close.icon : _default_close_icon,
      extra_classes: 'ecl-notification__close',
      extra_attributes: [{
        name: 'data-ecl-notification-close',
      }],
    }) only %}
  {% endif %}
  {% if _title is not empty %}
    <div class="ecl-notification__title">{{ _title }}</div>
  {% endif %}
  {% if _description is not empty %}
    <div class="ecl-notification__description">{{ _description }}</div>
  {% endif %}  
  {% if _links is not empty and _links is iterable %}
    {% for _link in _links %}
    <div class="ecl-notification__link">
      {% include '@ecl/link/link.html.twig' with _link|merge({
        extra_classes: _link.extra_classes|default('') ~ ' ecl-notification__link-item',
      }) only %}
    </div>
    {% endfor %}
  {% endif %}
  </div>
</div>

{% endapply %}
