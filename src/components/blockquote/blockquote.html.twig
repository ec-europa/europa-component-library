{% apply spaceless %}

{#
  Parameters:
    - "color_mode" (string) (default: '') Name of the color mode
    - "citation" (string) (default: '') The quote text
    - "author" (string) (default: '') The author of the quote
    - "lang" (string) (default: 'en') Language code for the citation text (ISO 639-1)
    - "picture" (associative array) (default: {}): Image for the blockquote, following ECL Picture structure
    - "sources_label" (string) (default: '') Label displayed before the sources list
    - "sources" (array) (default: []) Array of source references (ECL link objects or plain strings)
      - "link" (object) ECL link object:
        - "label" (string) (default: '') Link label
        - "path" (string) (default: '') Link URL
        or
      - "name" (string) (default: '') Plain text source
    - "extra_classes" (string) (default: '') Extra classes (space separated)
    - "extra_attributes" (array) (default: []): format: [
        {
          "name" (string) (default: ''),
          "value" (string) (default: '')
        },
        ...
      ]
#}

{# Internal properties #}

{% set _css_class = 'ecl-blockquote' %}
{% set _extra_attributes = '' %}
{% set _citation = citation|default('') %}
{% set _author = author|default('') %}
{% set _picture = picture|default({}) %}
{% set _sources_label = sources_label|default('') %}
{% set _sources = sources|default([]) %}
{% set _lang = lang|default('en') %}
{% set _color_mode = color_mode|default('') %}

{# Internal logic - Process properties #}

{% if _color_mode is not empty %}
  {% set _css_class = _css_class ~ ' ' ~ 'ecl-color-mode--' ~ _color_mode %}
{% endif %}

{% if extra_classes is defined and extra_classes is not empty %}
  {% set _css_class = _css_class ~ ' ' ~ extra_classes %}
{% endif %}

{% if extra_attributes is defined and extra_attributes is not empty and extra_attributes is iterable %}
  {% for attr in extra_attributes %}
    {% if attr.value is defined %}
      {% set _extra_attributes = _extra_attributes ~ ' ' ~ attr.name|e('html_attr') ~ '="' ~ attr.value|e('html_attr') ~ '"' %}
    {% else %}
      {% set _extra_attributes = _extra_attributes ~ ' ' ~ attr.name|e('html_attr') %}
    {% endif %}
  {% endfor %}
{% endif %}

{# Print the result #}

<figure
  class="{{ _css_class }}"
  {{ _extra_attributes|raw }}
>
  {% if _picture is not empty and _picture.img is not empty %}
    {% include '@ecl/picture/picture.html.twig' with {
      picture: _picture,
      extra_classes: "ecl-blockquote__picture",
      extra_image_classes: "ecl-blockquote__image",
    } only %}
  {% endif %}
  <div class="ecl-blockquote__body">
    <blockquote class="ecl-blockquote__quote">
      <p class="ecl-blockquote__citation" lang="{{ _lang }}">{{ _citation }}</p>
      <footer class="ecl-blockquote__attribution">
        <span class="ecl-blockquote__author">{{ _author }}</span>
        {% if _sources is not empty and _sources is iterable %}
          {% include '@ecl/source/source.html.twig' with {
            sources: _sources,
            label: _sources_label,
            branded: true,
            label_extra_classes: 'ecl-blockquote__sources-label',
            list_extra_classes: 'ecl-blockquote__sources-list',
            item_extra_classes: 'ecl-blockquote__sources-item',
            source_extra_classes: 'ecl-blockquote__source',
            extra_classes: 'ecl-blockquote__sources',
          } only %}
        {% endif %}
      </footer>
    </blockquote>
    
  </div>
</figure>

{% endapply %}
