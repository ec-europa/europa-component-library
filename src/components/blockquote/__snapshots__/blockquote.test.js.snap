exports[`Blockquote > Default > renders correctly 1`] = `
<jest>
  <figure
    class="ecl-blockquote"
  >
    <picture
      class="ecl-picture ecl-blockquote__picture"
    >
      <img
        alt="Image alternative text"
        class="ecl-blockquote__image"
        src="https://inno-ecl.s3.amazonaws.com/media/examples/example-image.jpg"
      />
    </picture>
    <div
      class="ecl-blockquote__body"
    >
      <blockquote
        class="ecl-blockquote__quote"
      >
        <p
          class="ecl-blockquote__citation"
          lang="en"
        >
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Fusce sodales, nisl tincidunt hendrerit elementum, purus risus tempus dui, sit amet cursus massa odio non lacus.
        </p>
        <footer
          class="ecl-blockquote__attribution"
        >
          <span
            class="ecl-blockquote__author"
          >
            Someone - 
            <cite>
              Lorem Ipsum
            </cite>
          </span>
        </footer>
      </blockquote>
      <div
        class="ecl-source ecl-blockquote__sources"
      >
        <span
          class="ecl-source__label"
        >
          Sources:
        </span>
        <ul
          class="ecl-source__list"
        >
          <li
            class="ecl-source__item"
          >
            <a
              class="ecl-link ecl-link--brand ecl-source__link"
              href="/example"
            >
              Eurostat
            </a>
          </li>
          <li
            class="ecl-source__item"
          >
            <a
              class="ecl-link ecl-link--brand ecl-source__link"
              href="/example"
            >
              DG CNECT
            </a>
          </li>
          <li
            class="ecl-source__item"
          >
            <span
              class="ecl-source__text"
            >
              European Commission
            </span>
          </li>
        </ul>
      </div>
    </div>
  </figure>
</jest>
`;

