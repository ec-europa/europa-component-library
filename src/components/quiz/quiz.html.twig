{% apply spaceless %}

{#
  Parameters:
    - "variant" (string) (default: reveal) poll otherwise
    - "title" (string) (default: '')
    - "description" (string) (default: '')
    - "with_background" (boolean) (default: false)
    - "full_width" (boolean) (default: false)
    - "slider" (boolean) (default: true)
    - "prev_label" (string) (default: '')
    - "next_label" (string) (default: '')
    - "items" (array) default([]) array of quiz-cards
      - "category" (string) (default: '') (poll variant)
      - "success_category" (string (default: '')
      - "error_category" (string (default: '')
      - "question" (string) (default: '')
      - "answer" (string) (default: '')
      - "answer_title" (string) (default: '')
      - "options" (array) Array of options (poll variant)
      - "icon" (object) Object of type icon
      - "back_icon" (object) Object of type icon
      - "flip_text" (string) Helper text (reveal variant)
      - "flip_icon" (object) Object of type icon
      - "back_text" (string) Text on the back of the card
      - "extra_classes" (string) (default: ''): Extra css classes, added to the root picture tag
      - "extra_image_classes" (optional) (string) (default: ''): Extra css classes, added to to the img tag
      - "extra_attributes" (optional) (array) (default: [])
        - "name" (string) Attribute name, eg. 'data-test'
        - "value" (optional) (string) Attribute value, eg: 'data-test-1'
    - "extra_classes" (string) (default: ''): Extra css classes, added to the root picture tag
    - "extra_image_classes" (optional) (string) (default: ''): Extra css classes, added to to the img tag
    - "extra_attributes" (optional) (array) (default: [])
      - "name" (string) Attribute name, eg. 'data-test'
      - "value" (optional) (string) Attribute value, eg: 'data-test-1'
#}

{# Internal properties #}

{% set _title = title|default('') %}
{% set _variant = variant|default('reveal') %}
{% set _description = description|default('') %}
{% set _items = items|default([]) %}
{% set _css_class = 'ecl-quiz' %}
{% set _slider = slider ?? true %}
{% set _prev_label = prev_label|default('') %}
{% set _next_label = next_label|default('') %}
{% set _full_width = full_width|default(false) %}
{% set _with_background = with_background|default(false) %}
{% set _extra_attributes = '' %}

{# Internal logic - Process properties #}

{% set _css_class = _css_class  ~ ' ecl-quiz--' ~ _variant %}

{% if _with_background %}
  {% set _css_class = _css_class ~ ' ecl-quiz--background' %}
{% endif %}

{% if _full_width %}
  {% set _css_class = _css_class ~ ' ecl-quiz--full-width' %}
{% endif %}

{% if extra_classes is defined and extra_classes is not empty %}
  {% set _css_class = _css_class ~ ' ' ~ extra_classes %}
{% endif %}

{% if extra_attributes is defined and extra_attributes is not empty and extra_attributes is iterable %}
  {% for attr in extra_attributes %}
    {% if attr.value is defined %}
      {% set _extra_attributes = _extra_attributes ~ ' ' ~ attr.name|e('html_attr') ~ '="' ~ attr.value|e('html_attr') ~ '"' %}
    {% else %}
      {% set _extra_attributes = _extra_attributes ~ ' ' ~ attr.name|e('html_attr') %}
    {% endif %}
  {% endfor %}
{% endif %}

<div 
  class="{{ _css_class }}"
  data-ecl-auto-init="Quiz"
  {{ _extra_attributes|raw }}
>
{% if _full_width %}
  <div class="ecl-container">
{% endif %}
  <div class="ecl-quiz__header">
    <div class="ecl-quiz__title">
      {{-  _title -}}
    </div>
    <div class="ecl-quiz__description">
      {{- _description -}}
    </div>
  </div>
{% if _items is iterable %}
  <div
    class="ecl-quiz__viewport"
    {%- if _slider -%}
      data-ecl-quiz-slider
    {%- endif -%}
  >
    <div class="ecl-quiz__list">
    {% for _item in _items %}
      {% include "@ecl/quiz/quiz-card.html.twig" with _item|merge({variant: _variant}) only %}
    {% endfor %}
    </div>
  </div>
{% endif %}
{%- if _slider -%}
  <div class="ecl-quiz__pager">
    <button class="ecl-quiz__prev">
      {% include "@ecl/icon/icon.html.twig" with {
        icon: {
          name: 'corner-arrow',
          transform: 'rotate-270',
          size: 'xs',
          style: 'monochrome',
        }
      } %}
      <span class="ecl-quiz__prev-label">
        {{ _prev_label }}
      </span>
    </button>
    <div class="ecl-quiz__dots"></div>
    <button class="ecl-quiz__next">
      <span class="ecl-quiz__next-label">
        {{ _next_label }}
      </span>
      {% include "@ecl/icon/icon.html.twig" with {
        icon: {
          name: 'corner-arrow',
          transform: 'rotate-90',
          size: 'xs',
          style: 'monochrome',
        }
      } %}
    </button>
    <script type="text/template" id="ecl-quiz__dot-template">
      <button class="ecl-quiz__dot"></button>
    </script>
  </div>
  <div class="ecl-quiz__counter"></div>
  <div
    class="ecl-quiz__live-region"
    aria-live="polite"
    aria-atomic="true"
  ></div>
{%- endif -%}
{% if _full_width %}
  </div>
{% endif %}
</div>

{% endapply %}