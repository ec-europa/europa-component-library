{% apply spaceless %}

{#
  Parameters:
  - "inverted" (boolean) (default: false)
  - "items" (array) (default: []):
    - category (string) default('')
    - currency_icon (object) default({}) Object of type ECL icon
    - amount (string) (default: '')
    - value (string) (default: 0)
    - currency (string) (default: '')
    - description (string (default: '')xl
  - "extra_classes" (string) (default: '')
  - "extra_attributes" (array) (default: []): format: [
        {
          "name" (string) (default: ''),
          "value" (string) (default: '')
        },
        ...
      ],
#}

{# Parameters #}

{% set _css_class = 'ecl-animated-numbers' %}
{% set _extra_attributes = '' %}
{% set _inverted = inverted|default(false) %}
{% set _items = items|default([]) %}
{% set _extra_classes = extra_classes|default('') %}

{# Internal logic - Process properties #}

{% set _css_class = _css_class ~ ' ecl-animated-numbers--col-' ~ _columns %}

{% if extra_classes is defined and extra_classes is not empty %}
  {% set _css_class = _css_class ~ ' ' ~ extra_classes %}
{% endif %}

{% if extra_attributes is defined and extra_attributes is not empty and extra_attributes is iterable %}
  {% for attr in extra_attributes %}
    {% if attr.value is defined %}
      {% set _extra_attributes = _extra_attributes ~ ' ' ~ attr.name|e('html_attr') ~ '="' ~ attr.value|e('html_attr') ~ '"' %}
    {% else %}
      {% set _extra_attributes = _extra_attributes ~ ' ' ~ attr.name|e('html_attr') %}
    {% endif %}
  {% endfor %}
{% endif %}

<div
  class="{{ _css_class }}"
  {{ _extra_attributes|raw }}
>

{% if items is defined and items is not empty and items is iterable %}
  <div class="ecl-animated-numbers__items">
  {% for item in items %}
    {% set _item_class = 'ecl-animated-number' %}
    {% if loop.first %}
      {% set _item_class = _item_class ~ ' is-first' %}
    {% endif %}
    <div class="{{ _item_class }}">
      <div class="ecl-animated_number__header">
      {% if _item.category is not empty %}
        <div class="ecl-animated-number__category">
          {{- item.cateogry -}}
        </div>
      {% endif %}
      {% if item.currency_icon is defined and item.currency_icon is not empty %}
        {% include '@ecl/icon/icon.html.twig' with {
          icon: item.icon|merge({
            size: _icon_size,
          }),
          extra_classes: 'ecl-animated-numbers__icon',
        } only %}
      {% endif %}
      </div>
      <div class="ecl-animated-number__number">
      {% if item.amount is not empty %}
        <span class="ecl-animated-number__amount">
          {{- item.amount -}}
        </span>
      {% endif %}
      {% if item.value is defined and item.value is not empty %}
        <div class="ecl-animated-numbers__value">
          {{- item.value -}}
        </div>
      {% endif %}
      {% if item.currency is defined and item.currenvy is not empty %}
        <div class="ecl-animated-numbers__value">
          {{- item.currency -}}
        </div>
      {% endif %}
      </div>
    {% if item.description is defined and item.description is not empty %}
      <div class="ecl-animated-numbers__description">
        {{- item.description -}}
      </div>
    {% endif %}
    </div>
  {% endfor %}
  </div>
{% endif %}
</div>

{% endapply %}
