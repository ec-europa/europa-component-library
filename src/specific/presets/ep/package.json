{
  "name": "@ecl/specific-preset-ep",
  "author": "European Commission",
  "license": "EUPL-1.2",
  "version": "5.4.0",
  "description": "ECL preset for the EP website: EC preset compiled with EP overrides",
  "main": "dist/scripts/ecl-ep.js",
  "module": "dist/scripts/ecl-esm-ep.js",
  "style": "dist/styles/ecl-ep.css",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:copy": "ecl-builder copy",
    "build:scripts": "cross-env ECL_SYSTEM=ec ecl-builder scripts",
    "build:styles": "cross-env ECL_SYSTEM=ec ecl-builder styles",
    "build": "run-p build:*",
    "clean": "rimraf build dist",
    "dist": "cross-env NODE_ENV=production run-p build:*",
    "prepublish": "npm run clean && npm run build && npm run dist",
    "styles:main": "cross-env ECL_SYSTEM=ec ECL_EP_MAIN_ONLY=true ecl-builder styles",
    "watch": "cross-env ECL_SYSTEM=ec ecl-builder watch"
  },
  "dependencies": {
    "@ecl/preset-ec": "5.4.0"
  },
  "devDependencies": {
    "@ecl/builder": "5.4.0",
    "cross-env": "10.1.0",
    "npm-run-all": "4.1.5",
    "rimraf": "6.1.4"
  }
}
